# Credential template for local development. Copy to `.env`, immediately set
# mode 0600, and fill in real values. `.env` is gitignored and must never be
# committed. `.envrc` (direnv)
# auto-loads `.env` so opencode.json's {env:...} references resolve.
#
#   cp .env.example .env && chmod 600 .env && $EDITOR .env && direnv allow

# Azure Cognitive Services (opencode.json → provider.azure-cognitive-services)
AZURE_COGNITIVE_SERVICES_API_KEY=
AZURE_COGNITIVE_SERVICES_BASE_URL=

# Azure AI Foundry (opencode.json → provider.azure-ai-foundry)
AZURE_AI_FOUNDRY_BASE_URL=

# fable-monitor runtime configuration. Empty values are treated as unset.
# Booleans accept only 1/0; positive integer settings reject 0 and malformed
# values. Uncomment optional settings only when used. Installers intentionally
# do not persist ANTHROPIC_API_KEY; inject it through the service environment.
# FABLE_MONITOR_SOURCES=/path/to/sources.json
# FABLE_MONITOR_ONLY=anthropic_model_list,anthropic_statement
# FABLE_MONITOR_DISABLE=google_news
FABLE_MONITOR_STATE=fable_monitor_state.jsonl.zst
FABLE_MONITOR_LOG=fable_monitor_events.jsonl.zst
FABLE_MONITOR_FAST_INTERVAL=45
# FABLE_MONITOR_LOOP=60
FABLE_MONITOR_LOOP_MAX_FAILURES=3
# FABLE_MONITOR_REQUIRED_SOURCES=anthropic_model_list
FABLE_MONITOR_MIN_DECISIVE_SOURCES=1
# FABLE_MONITOR_FORCE=1
FABLE_MONITOR_PORT=8080
FABLE_MONITOR_READER=0
# FABLE_MONITOR_WEBHOOK=https://example.com/events
# FABLE_MONITOR_HEARTBEAT_URL=https://example.com/heartbeat
# FABLE_MONITOR_EVENT_SINK=/path/to/events.ndjson
# FABLE_MONITOR_NOTIFY=notify-command "$1"
FABLE_MONITOR_ESCALATE_AFTER=3600
# FABLE_MONITOR_METRICS=1
# FABLE_MONITOR_STATS=1
FABLE_MONITOR_MAX_EVENTS=100000
# `preflight --json` validates these paths and emits fable-monitor.preflight/1.
# Test-only: read <directory>/<source_id> instead of making network requests.
# FABLE_MONITOR_FIXTURES=tests/fixtures/baseline
# ANTHROPIC_API_KEY=replace-me
