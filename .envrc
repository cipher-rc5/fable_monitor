# direnv — https://direnv.net
# Auto-loads the project's .env into the environment on `cd` into this dir.
# opencode does NOT read .env itself, so this makes {env:...} refs in
# opencode.json (baseURLs, API key) resolve when you launch opencode.
#
# One-time setup:
#   brew install direnv
#   add `eval "$(direnv hook zsh)"` to ~/.zshrc  (bash: direnv hook bash)
#   run `direnv allow` in this directory once.
#
# .env stays gitignored; .envrc is safe to commit (it references, not embeds).
# dotenv_if_exists (not bare `dotenv`) so a missing .env warns instead of
# aborting the whole .envrc load. Create it with: cp .env.example .env
dotenv_if_exists

# Older copies of .env.example used blank assignments for optional runtime
# settings. Keep those templates harmless for all commands launched by direnv.
for var in FABLE_MONITOR_SOURCES FABLE_MONITOR_ONLY FABLE_MONITOR_DISABLE \
  FABLE_MONITOR_STATE FABLE_MONITOR_LOG FABLE_MONITOR_FAST_INTERVAL \
  FABLE_MONITOR_LOOP FABLE_MONITOR_LOOP_MAX_FAILURES FABLE_MONITOR_REQUIRED_SOURCES \
  FABLE_MONITOR_MIN_DECISIVE_SOURCES FABLE_MONITOR_FORCE FABLE_MONITOR_PORT \
  FABLE_MONITOR_READER FABLE_MONITOR_WEBHOOK FABLE_MONITOR_HEARTBEAT_URL \
  FABLE_MONITOR_EVENT_SINK FABLE_MONITOR_NOTIFY FABLE_MONITOR_ESCALATE_AFTER \
  FABLE_MONITOR_METRICS FABLE_MONITOR_STATS FABLE_MONITOR_MAX_EVENTS \
  FABLE_MONITOR_FIXTURES ANTHROPIC_API_KEY; do
  [ -n "${!var:-}" ] || unset "$var"
done

# Fail loudly at `cd` time if a credential opencode.json needs is unset, rather
# than letting opencode start with an empty {env:...} and fail cryptically later.
for var in AZURE_COGNITIVE_SERVICES_API_KEY AZURE_COGNITIVE_SERVICES_BASE_URL AZURE_AI_FOUNDRY_BASE_URL; do
  [ -n "${!var:-}" ] || log_error "direnv: $var is unset (fill in .env — see .env.example)"
done
