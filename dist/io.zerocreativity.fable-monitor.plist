<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.zerocreativity.fable-monitor</string>

    <!-- Edit this path to the built binary. -->
    <key>ProgramArguments</key>
    <array>
        <string>/path/to/fable_monitor/zig-out/bin/fable-monitor</string>
    </array>

    <!-- Working directory; the default state file lands here if FABLE_MONITOR_STATE is unset. -->
    <key>WorkingDirectory</key>
    <string>/path/to/fable_monitor</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>FABLE_MONITOR_STATE</key>
        <string>/path/to/fable_monitor/fable_monitor_state.jsonl.zst</string>
        <key>FABLE_MONITOR_LOG</key>
        <string>/path/to/fable_monitor/fable_monitor_events.jsonl.zst</string>
        <key>FABLE_MONITOR_NOTIFY</key>
        <!-- Alert text is read via `item 1 of argv` — passed as data, never
             spliced into AppleScript source (see tests/notify_quoting.sh). -->
        <string>osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "fable-monitor"' -e 'end run' -- "$1"</string>
        <!-- Ensure curl and zstd are resolvable. -->
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>

    <!-- Poll every 60 seconds (matches the installer default; conditional
         requests keep the fast cadence cheap). -->
    <key>StartInterval</key>
    <integer>60</integer>

    <!-- Also run once at load. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/path/to/fable_monitor/fable-monitor.out.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/fable_monitor/fable-monitor.err.log</string>
</dict>
</plist>
